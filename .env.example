# Pilih salah satu mode LLM.

# OpenAI / OpenAI-compatible API
LLM_PROVIDER=openai
LLM_API_KEY=isi_api_key_kamu
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Ollama lokal
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://localhost:11434

LLM_TIMEOUT=30

# OJS SAST agent/container.
OJS_SOURCE_PATH=ojs/ojs-main
SCANNER_OUTPUT_PATH=scan-output/latest.json
SCANNER_INTERVAL_SECONDS=300
SCANNER_ONESHOT=false

# ============================================================================
# AUTOMATIC SCANNING & SCHEDULING (NEW)
# ============================================================================

# Enable the automated scanner (runs in background every 6 hours)
ENABLE_SCHEDULER=true

# Interval between scans in hours (default: 6)
SCAN_INTERVAL_HOURS=6

# ============================================================================
# EMAIL CONFIGURATION FOR SENDING REPORTS (NEW)
# ============================================================================
# Leave empty to disable email notifications

# SMTP Server address
SMTP_SERVER=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Sender email address (your email)
SENDER_EMAIL=your-email@gmail.com

# Sender password or app password
# For Gmail: Use App Password (not your regular password)
# For other providers: Use your email password
SENDER_PASSWORD=your-app-password
